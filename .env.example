# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must NEVER be committed. Production values come from the
# deployment environment, not from any file in this repository.

# --- Database (must match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/tutorspoint_dev
DB_USERNAME=tutorspoint
DB_PASSWORD=replace_me

# Consumed by docker-compose.yml when it starts the local postgres container
POSTGRES_DB=tutorspoint_dev
POSTGRES_USER=tutorspoint
POSTGRES_PASSWORD=replace_me

# --- Security ---
# Base64-encoded 256-bit key. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace_me
# Token lifetimes are policy, not secrets: they live in application.yml.

# --- Mail ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
# The From address and display name on every notification email
MAIL_FROM=no-reply@tutorspoint.xyz
MAIL_FROM_NAME=TutorsPoint

# --- SMS gateway (Notify.lk) ---
# Only read outside the dev profile. In dev, LoggingSmsProvider prints the OTP to the
# log and nothing is sent, so these can stay unset locally.
SMS_NOTIFY_LK_BASE_URL=https://app.notify.lk/api/v1
SMS_NOTIFY_LK_USER_ID=replace_me
SMS_NOTIFY_LK_API_KEY=replace_me
SMS_NOTIFY_LK_SENDER_ID=TutorsPoint

# --- Frontend ---
# Where the verification and password-reset links in outgoing email point. The link lands on
# a frontend page, which posts the token to the API.
FRONTEND_BASE_URL=http://localhost:5173

# --- Server ---
SERVER_PORT=8080
