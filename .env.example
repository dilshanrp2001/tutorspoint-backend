# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must NEVER be committed. Production values come from the
# deployment environment, not from any file in this repository.

# --- Database (must match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/tutorspoint_dev
DB_USERNAME=tutorspoint
DB_PASSWORD=replace_me

# Consumed by docker-compose.yml when it starts the local postgres container
POSTGRES_DB=tutorspoint_dev
POSTGRES_USER=tutorspoint
POSTGRES_PASSWORD=replace_me

# --- Security ---
# Base64-encoded 256-bit key. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace_me
# Token lifetimes are policy, not secrets: they live in application.yml.

# --- Mail ---
# Resend over SMTP (STARTTLS on 587). The username is literally "resend"; the password is
# a Resend API key with sending access, scoped to the tutorspoint.xyz domain.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace_me
# The From address and display name on every notification email
MAIL_FROM=no-reply@tutorspoint.xyz
MAIL_FROM_NAME=TutorsPoint

# --- Phone verification code (FR-A2) ---
# EMAIL (the default) sends the six-digit code to the registered email address, which costs
# nothing and needs no gateway account — but it verifies the address, not the handset, so the
# phone number stays effectively unproven. Set SMS once the gateway credentials below are real.
OTP_DELIVERY=EMAIL

# --- SMS gateway (Notify.lk) ---
# Only read outside the dev profile. In dev, LoggingSmsProvider prints the OTP to the
# log and nothing is sent, so these can stay unset locally. Outside dev they must be set
# even while OTP_DELIVERY=EMAIL: the adapter is validated at startup either way.
SMS_NOTIFY_LK_BASE_URL=https://app.notify.lk/api/v1
SMS_NOTIFY_LK_USER_ID=replace_me
SMS_NOTIFY_LK_API_KEY=replace_me
SMS_NOTIFY_LK_SENDER_ID=TutorsPoint

# --- Frontend ---
# Where the links in outgoing email point: verification and password reset, and the enquiry
# thread a tutor or parent is told to go and read. The link lands on a frontend page, which
# calls the API from there.
FRONTEND_BASE_URL=http://localhost:5173

# --- File storage ---
# Where uploaded documents, profile photos and intro videos are written. Local disk for
# the MVP (LocalDiskFileStorage); an object store replaces the implementation later
# without changing this contract. In production this MUST be a mounted volume - a path
# inside the container would lose every upload on the next deployment.
STORAGE_ROOT=./var/uploads

# --- First administrator ---
# There is no admin registration. When ADMIN_BOOTSTRAP_EMAIL is set, an active admin account
# is created at startup (every profile). Nothing happens if the email is already an admin, and
# an existing account's password is never overwritten. Remove these once the account exists.
# The password must be at least 12 characters; the phone number is E.164 and must be unused.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=TutorsPoint Admin
ADMIN_BOOTSTRAP_PHONE=

# --- Demo data (dev profile only) ---
# Demo tutors seeded on first startup so search has realistic volume. Skipped once they
# exist. All sign in with DemoTutor2026. Set to 0 to keep the local directory empty.
SEED_DEMO_TUTORS=500

# --- Server ---
SERVER_PORT=8080
