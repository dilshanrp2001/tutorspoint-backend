# Rendered by the nginx image's entrypoint into /etc/nginx/conf.d/default.conf, with ${DOMAIN}
# from the environment (only variables that are set are substituted, so nginx's own $vars are
# left alone). Replaces the standalone default.conf baked into the frontend image.

# Docker's embedded DNS. proxy_pass below takes a variable, so `backend` is re-resolved rather
# than fixed at startup: a redeployed backend container gets a new address, and nginx would
# otherwise keep sending to the old one until restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

# One certificate covers ${DOMAIN} and www.${DOMAIN} (issue-certificate.sh), so both 443
# servers below share these.
ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:TLS:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

server {
    listen 80;
    listen [::]:80;
    # www too: certbot renews both names through this webroot.
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    # Let's Encrypt HTTP-01 challenges, written by certbot into the shared webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # The container healthcheck, from inside the container only.
    location = /nginx-health {
        allow 127.0.0.1;
        deny all;
        access_log off;
        return 200 "ok\n";
    }

    # Straight to the canonical host, so http://www. is one redirect, not two.
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www is only ever a redirect: the app, its cookies and the backend's CORS origin
# (FRONTEND_BASE_URL) all live on the bare domain.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    server_tokens off;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    # The API. Only /api: the actuator and the backend's other paths are not reachable from
    # outside at all. The backend sets its own security headers on these responses.
    location /api/ {
        set $backend http://backend:8080;
        proxy_pass $backend;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwritten, not appended: whatever X-Forwarded-For a client sends is discarded, so
        # the backend's rate limits and audit log see the address nginx actually accepted.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";

        # Just above spring.servlet.multipart.max-request-size (10MB), so the backend - not
        # nginx - is the one that refuses an oversized upload, with its own error body.
        client_max_body_size 11m;
        proxy_read_timeout 60s;
    }

    # Everything else is the single-page app, served as the frontend image says.
    include /etc/nginx/snippets/tutorspoint-spa.conf;
}
