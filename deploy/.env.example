# Production environment for deploy/compose.yml. Copy to deploy/.env ON THE SERVER and fill in:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit it, never paste it into an issue or a chat. Every value
# below is a placeholder. DEPLOYMENT.md describes each variable and how to generate it.

# --- Site ---
DOMAIN=tutorspoint.example
LETSENCRYPT_EMAIL=ops@example.com

# --- Releases (written by deploy.sh; set by hand only for the first deploy) ---
BACKEND_TAG=sha-0000000
FRONTEND_TAG=sha-0000000

# --- Database (Neon) ---
# Neon console -> the project -> Connect: the DIRECT connection (Connection pooling OFF, no
# "-pooler" in the host), rewritten as JDBC: user and password go in their own variables, and
# Neon's "channel_binding" is spelled "channelBinding" for the JDBC driver (it ignores the other).
DB_URL=jdbc:postgresql://ep-example-123456.ap-southeast-1.aws.neon.tech/tutorspoint?sslmode=require&channelBinding=require
DB_USERNAME=tutorspoint
DB_PASSWORD=replace_me

# --- Backend ---
# openssl rand -base64 32
JWT_SECRET=replace_me

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace_me
MAIL_FROM=no-reply@tutorspoint.example
MAIL_FROM_NAME=TutorsPoint

PHONE_VERIFICATION_ENABLED=false
OTP_DELIVERY=EMAIL
# Required even while phone verification is off: the adapter is validated at startup.
SMS_NOTIFY_LK_BASE_URL=https://app.notify.lk/api/v1
SMS_NOTIFY_LK_USER_ID=replace_me
SMS_NOTIFY_LK_API_KEY=replace_me
SMS_NOTIFY_LK_SENDER_ID=TutorsPoint

# First deploy only - delete these four lines once the admin can sign in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=TutorsPoint Admin
ADMIN_BOOTSTRAP_PHONE=
