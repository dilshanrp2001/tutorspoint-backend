#!/usr/bin/env bash
# TutorsPoint backups: pg_dump + the uploads volume, encrypted, copied off the server.
#
#   tp-backup schedule                  run `backup nightly` every day at BACKUP_TIME_UTC
#   tp-backup backup [label]            one backup now (label: nightly, predeploy, manual...)
#   tp-backup list                      the backups held off-server, oldest first
#   tp-backup drill [name|latest]       restore into a scratch database, check it, drop it
#   tp-backup restore <name|latest> --yes [--with-uploads]
#                                       replace the live database (the backend must be stopped)
#
# Backups are encrypted with age to BACKUP_AGE_RECIPIENT, a public key. The matching private
# key is NOT on the server: a stolen server or storage bucket does not expose old backups.
# drill and restore need it, mounted at $AGE_IDENTITY_FILE for the duration of the run.
#
# Layout off-server:  $BACKUP_REMOTE/<yyyymmddThhmmssZ>-<label>/{db.dump.age,uploads.tar.age,MANIFEST}
set -Eeuo pipefail

REMOTE=${BACKUP_REMOTE%/}
WORK=${BACKUP_WORK_DIR:-/tmp/tp-backup}
UPLOADS=${UPLOADS_DIR:-/uploads}
IDENTITY=${AGE_IDENTITY_FILE:-/run/secrets/age-identity}
DRILL_DB=${PGDATABASE}_restore_drill
# The backend image's user, which must own restored uploads (Dockerfile: uid 10001).
UPLOADS_OWNER=10001:10001

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }

# compose.yml passes these as empty strings while backups are off, so `set -u` cannot catch them.
for var in BACKUP_REMOTE BACKUP_AGE_RECIPIENT \
           RCLONE_CONFIG_OFFSITE_PROVIDER RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID \
           RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY; do
    [[ -n "${!var:-}" ]] || die "$var is empty: fill in the BACKUP_* values in .env (DEPLOYMENT.md, \"Backups\")"
done

# psql as the superuser, against the maintenance database: creating, renaming and dropping a
# database cannot be done from inside it, and the application role may not create one.
as_superuser() {
    PGUSER=$POSTGRES_SUPERUSER PGPASSWORD=$POSTGRES_SUPERUSER_PASSWORD \
        psql -v ON_ERROR_STOP=1 -q -X -d postgres "$@"
}

heartbeat() {
    [[ -n "${BACKUP_HEARTBEAT_URL:-}" ]] || return 0
    curl -fsS -m 10 --retry 3 -o /dev/null "${BACKUP_HEARTBEAT_URL}$1" \
        || log "warning: heartbeat ping to ${BACKUP_HEARTBEAT_URL}$1 failed"
}

# ---- backup ------------------------------------------------------------------------------

cmd_backup() {
    local label=${1:-manual}
    [[ "$label" =~ ^[a-z0-9-]+$ ]] || die "label must be lowercase letters, digits and dashes"
    local name
    name="$(date -u +%Y%m%dT%H%M%SZ)-$label"
    trap 'heartbeat /fail' ERR

    rm -rf "$WORK" && mkdir -p "$WORK/out"
    log "backup $name: dumping database $PGDATABASE"
    pg_dump --format=custom --file "$WORK/db.dump"
    # The dump is only worth uploading if it can be read back.
    pg_restore --list "$WORK/db.dump" > /dev/null

    log "backup $name: archiving uploads"
    tar -C "$UPLOADS" -cf "$WORK/uploads.tar" .

    local schema files
    schema=$(psql -X -tA -c "SELECT version FROM flyway_schema_history WHERE success AND version IS NOT NULL ORDER BY installed_rank DESC LIMIT 1")
    files=$(tar -tf "$WORK/uploads.tar" | grep -vc '/$' || true)

    log "backup $name: encrypting"
    age -r "$BACKUP_AGE_RECIPIENT" -o "$WORK/out/db.dump.age" "$WORK/db.dump"
    age -r "$BACKUP_AGE_RECIPIENT" -o "$WORK/out/uploads.tar.age" "$WORK/uploads.tar"
    # Nothing secret in here: it is what a restore checks the decrypted files against.
    {
        echo "name=$name"
        echo "database=$PGDATABASE"
        echo "schema_version=$schema"
        echo "upload_files=$files"
        echo "db_dump_sha256=$(sha256sum "$WORK/db.dump" | cut -d' ' -f1)"
        echo "uploads_tar_sha256=$(sha256sum "$WORK/uploads.tar" | cut -d' ' -f1)"
        echo "pg_dump=$(pg_dump --version)"
    } > "$WORK/out/MANIFEST"

    log "backup $name: uploading to $REMOTE/$name"
    rclone copy "$WORK/out" "$REMOTE/$name"
    # Size and hash of every file, as stored, against what was sent.
    rclone check --one-way "$WORK/out" "$REMOTE/$name"

    log "backup $name: pruning backups older than ${BACKUP_RETENTION_DAYS} days"
    rclone delete --min-age "${BACKUP_RETENTION_DAYS}d" "$REMOTE"
    rclone rmdirs --leave-root "$REMOTE" 2>/dev/null || true

    rm -rf "$WORK"
    trap - ERR
    log "backup $name: done (schema V$schema, $files uploaded files)"
    heartbeat ""
}

cmd_schedule() {
    [[ "$BACKUP_TIME_UTC" =~ ^[0-2][0-9]:[0-5][0-9]$ ]] || die "BACKUP_TIME_UTC must be HH:MM"
    log "schedule: backup every day at $BACKUP_TIME_UTC UTC to $REMOTE"
    while :; do
        local next now
        now=$(date -u +%s)
        next=$(date -u -d "today $BACKUP_TIME_UTC" +%s)
        (( next > now )) || next=$(date -u -d "tomorrow $BACKUP_TIME_UTC" +%s)
        log "schedule: next backup at $(date -u -d "@$next" +%Y-%m-%dT%H:%M:%SZ)"
        sleep $(( next - now ))
        # A process of its own, so one failed night is logged (and pinged) without ending the
        # loop. Not a subshell: bash switches `set -e` off inside anything on the left of ||,
        # and a failed pg_dump would then carry on and upload whatever it left behind.
        "$0" backup nightly || log "ERROR: nightly backup failed; see the lines above"
    done
}

# ---- reading a backup back ---------------------------------------------------------------

cmd_list() {
    rclone lsf --dirs-only "$REMOTE" | sed 's|/$||' | sort
}

resolve() {
    local wanted=${1:-latest} name
    if [[ "$wanted" == latest ]]; then
        name=$(cmd_list | tail -n 1)
        [[ -n "$name" ]] || die "no backups found in $REMOTE"
    else
        name=$wanted
    fi
    printf '%s' "$name"
}

manifest_value() { grep -E "^$1=" "$WORK/MANIFEST" | cut -d= -f2-; }

# Downloads and decrypts one backup into $WORK, and proves the files are the ones that were
# written: the decrypted bytes must hash to what the manifest recorded at backup time.
fetch() {
    local name=$1
    [[ -r "$IDENTITY" ]] || die "no age private key at $IDENTITY (mount it; DEPLOYMENT.md, Restore)"
    rm -rf "$WORK" && mkdir -p "$WORK/in"
    log "fetch $name: downloading"
    rclone copy "$REMOTE/$name" "$WORK/in"
    [[ -s "$WORK/in/MANIFEST" ]] || die "$name has no MANIFEST - not a complete backup"
    cp "$WORK/in/MANIFEST" "$WORK/MANIFEST"

    log "fetch $name: decrypting"
    age -d -i "$IDENTITY" -o "$WORK/db.dump" "$WORK/in/db.dump.age"
    age -d -i "$IDENTITY" -o "$WORK/uploads.tar" "$WORK/in/uploads.tar.age"
    rm -rf "$WORK/in"

    [[ "$(sha256sum "$WORK/db.dump" | cut -d' ' -f1)" == "$(manifest_value db_dump_sha256)" ]] \
        || die "db.dump does not match the checksum recorded when it was taken"
    [[ "$(sha256sum "$WORK/uploads.tar" | cut -d' ' -f1)" == "$(manifest_value uploads_tar_sha256)" ]] \
        || die "uploads.tar does not match the checksum recorded when it was taken"
    log "fetch $name: checksums match (schema V$(manifest_value schema_version), $(manifest_value upload_files) uploaded files)"
}

# (Re)creates an empty database owned by the application role and restores the dump into it,
# as that role, in one transaction: a restore either completes or leaves nothing behind.
restore_into() {
    local db=$1
    as_superuser -v db="$db" -v owner="$PGUSER" <<'SQL'
DROP DATABASE IF EXISTS :"db" WITH (FORCE);
CREATE DATABASE :"db" OWNER :"owner" ENCODING 'UTF8' TEMPLATE template0;
REVOKE ALL ON DATABASE :"db" FROM PUBLIC;
SQL
    log "restoring into database $db"
    pg_restore --dbname "$db" --no-owner --no-privileges --exit-on-error --single-transaction \
        "$WORK/db.dump"
}

# What a restored database must satisfy before anyone relies on it.
check_restored() {
    local db=$1 failed=0 schema bad missing
    schema=$(psql -X -tA -d "$db" -c "SELECT version FROM flyway_schema_history WHERE success AND version IS NOT NULL ORDER BY installed_rank DESC LIMIT 1")
    if [[ "$schema" == "$(manifest_value schema_version)" ]]; then
        log "check: schema is at V$schema, as when the backup was taken"
    else
        log "FAIL: schema is at V$schema, the backup recorded V$(manifest_value schema_version)"; failed=1
    fi

    bad=$(psql -X -tA -d "$db" -c "SELECT count(*) FROM flyway_schema_history WHERE NOT success")
    if [[ "$bad" == 0 ]]; then log "check: no failed migrations in the history"
    else log "FAIL: $bad failed migrations in the history"; failed=1; fi

    # Each query's failure is recorded explicitly: this function runs on the left of ||, where
    # `set -e` does not apply, and a query that fails must not read as a check that passed.
    log "check: row counts"
    psql -X -v ON_ERROR_STOP=1 -d "$db" -c "SELECT 'users' AS table, count(*) FROM users
                         UNION ALL SELECT 'tutor_profiles', count(*) FROM tutor_profiles
                         UNION ALL SELECT 'enquiries', count(*) FROM enquiries
                         UNION ALL SELECT 'verification_documents', count(*) FROM verification_documents
                         UNION ALL SELECT 'audit_logs', count(*) FROM audit_logs"         || { log "FAIL: the restored tables could not be counted"; failed=1; }

    # Every file a restored row points at must be in the restored uploads. A database without
    # the files would pass every check above and still lose every verification document.
    tar -tf "$WORK/uploads.tar" | sed 's|^\./||' | grep -v '/$' | sort > "$WORK/files.txt"
    psql -X -tA -v ON_ERROR_STOP=1 -d "$db" -c "
        SELECT storage_key FROM verification_documents
        UNION SELECT substring(photo_url FROM '[a-z]+/[0-9]{4}/[0-9]{2}/[0-9a-f-]{36}\.[a-z0-9]{2,5}')
              FROM tutor_profiles WHERE photo_url IS NOT NULL
        UNION SELECT substring(intro_video_url FROM '[a-z]+/[0-9]{4}/[0-9]{2}/[0-9a-f-]{36}\.[a-z0-9]{2,5}')
              FROM tutor_profiles WHERE intro_video_url IS NOT NULL" > "$WORK/referenced.raw"         || { log "FAIL: the files the database references could not be listed"; failed=1; }
    grep -v '^$' "$WORK/referenced.raw" | sort -u > "$WORK/referenced.txt" || true
    missing=$(comm -23 "$WORK/referenced.txt" "$WORK/files.txt" | wc -l)
    if [[ "$missing" == 0 ]]; then
        log "check: all $(wc -l < "$WORK/referenced.txt") files referenced by the database are in the uploads archive"
    else
        log "FAIL: $missing referenced files are missing from the uploads archive, e.g.:"
        comm -23 "$WORK/referenced.txt" "$WORK/files.txt" | head -n 5
        failed=1
    fi
    return $failed
}

cmd_drill() {
    local name
    name=$(resolve "${1:-latest}")
    log "drill $name: restoring into scratch database $DRILL_DB; the live database is not touched"
    fetch "$name"
    restore_into "$DRILL_DB"
    local result=0
    check_restored "$DRILL_DB" || result=1
    as_superuser -v db="$DRILL_DB" <<'SQL'
DROP DATABASE :"db" WITH (FORCE);
SQL
    rm -rf "$WORK"
    if (( result == 0 )); then log "drill $name: PASSED"; else die "drill $name: FAILED"; fi
}

cmd_restore() {
    local target="" yes=0 with_uploads=0 arg
    for arg in "$@"; do
        case "$arg" in
            --yes) yes=1 ;;
            --with-uploads) with_uploads=1 ;;
            -*) die "unknown option $arg" ;;
            *) target=$arg ;;
        esac
    done
    [[ -n "$target" ]] || die "usage: tp-backup restore <name|latest> --yes [--with-uploads]"
    local name
    name=$(resolve "$target")
    (( yes )) || die "this replaces database $PGDATABASE with backup $name. Stop the backend, then re-run with --yes"

    local connected
    connected=$(as_superuser -tA -v db="$PGDATABASE" <<'SQL'
SELECT count(*) FROM pg_stat_activity WHERE datname = :'db' AND pid <> pg_backend_pid();
SQL
)
    (( connected == 0 )) || die "$connected connections to $PGDATABASE are open - stop the backend first (docker compose stop backend)"

    fetch "$name"

    # The current database is renamed, not dropped: if the backup turns out to be the wrong one,
    # nothing has been lost yet. DEPLOYMENT.md says when to drop it.
    local kept=""
    local exists
    exists=$(as_superuser -tA -v db="$PGDATABASE" <<'SQL'
SELECT count(*) FROM pg_database WHERE datname = :'db';
SQL
)
    if (( exists == 1 )); then
        kept="${PGDATABASE}_before_restore_$(date -u +%Y%m%d%H%M%S)"
        log "restore: keeping the current database as $kept"
        as_superuser -v db="$PGDATABASE" -v kept="$kept" <<'SQL'
ALTER DATABASE :"db" RENAME TO :"kept";
SQL
    fi

    restore_into "$PGDATABASE"
    check_restored "$PGDATABASE" || die "the restored database failed its checks; the previous one is still there as ${kept:-<none>}"

    if (( with_uploads )); then
        # Extracted over what is there, never deleting: keys are unique, so a file already
        # present is the same file, and one newer than the backup is simply kept.
        log "restore: extracting uploads into $UPLOADS"
        tar -C "$UPLOADS" -xf "$WORK/uploads.tar"
        chown -R "$UPLOADS_OWNER" "$UPLOADS"
    fi
    rm -rf "$WORK"
    log "restore $name: done.${kept:+ Previous database kept as $kept.} Start the backend: docker compose up -d backend"
}

case "${1:-}" in
    schedule) cmd_schedule ;;
    backup) shift; cmd_backup "$@" ;;
    list) cmd_list ;;
    drill) shift; cmd_drill "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
