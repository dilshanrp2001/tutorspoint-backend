# Production environment for deploy/compose.yml. Copy to deploy/.env ON THE SERVER and fill in:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit it, never paste it into an issue or a chat. Every value
# below is a placeholder. DEPLOYMENT.md describes each variable and how to generate it.

# --- Site ---
DOMAIN=tutorspoint.example
LETSENCRYPT_EMAIL=ops@example.com

# --- Releases (written by deploy.sh; set by hand only for the first deploy) ---
BACKEND_TAG=sha-0000000
FRONTEND_TAG=sha-0000000

# --- PostgreSQL ---
# The superuser: used only to create the cluster and by restores. Not given to the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
# The application's own role and database, created on first start (postgres/init).
DB_NAME=tutorspoint
DB_USERNAME=tutorspoint
DB_PASSWORD=replace_me

# --- Backend ---
# openssl rand -base64 32
JWT_SECRET=replace_me

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace_me
MAIL_FROM=no-reply@tutorspoint.example
MAIL_FROM_NAME=TutorsPoint

PHONE_VERIFICATION_ENABLED=false
OTP_DELIVERY=EMAIL
# Required even while phone verification is off: the adapter is validated at startup.
SMS_NOTIFY_LK_BASE_URL=https://app.notify.lk/api/v1
SMS_NOTIFY_LK_USER_ID=replace_me
SMS_NOTIFY_LK_API_KEY=replace_me
SMS_NOTIFY_LK_SENDER_ID=TutorsPoint

# Small servers (2 GB RAM, e.g. AWS t3.small): the image's default heap is 75% of RAM, which
# leaves too little for postgres. Uncomment both on a 2 GB server; leave them out on 4 GB+.
# JAVA_TOOL_OPTIONS=-Xmx640m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -Djava.awt.headless=true
# DB_POOL_SIZE=5

# First deploy only - delete these four lines once the admin can sign in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=TutorsPoint Admin
ADMIN_BOOTSTRAP_PHONE=

# --- Backups (off by default) ---
# To turn them on: uncomment every line below and fill them in. COMPOSE_PROFILES=backup starts
# the nightly backup service and makes deploy.sh take a predeploy backup. DEPLOYMENT.md, "Backups".
# COMPOSE_PROFILES=backup
# rclone remote "offsite" + bucket/path. The bucket must already exist.
# BACKUP_REMOTE=offsite:tutorspoint-backups/production
# BACKUP_S3_PROVIDER=Cloudflare
# BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=replace_me
# BACKUP_S3_SECRET_ACCESS_KEY=replace_me
# The PUBLIC half of the backup key (age1...). The private half is never on this server.
# BACKUP_AGE_RECIPIENT=age1replace_me
# 20:30 UTC is 02:00 in Sri Lanka.
# BACKUP_TIME_UTC=20:30
# BACKUP_RETENTION_DAYS=30
# Optional: pinged after every backup (append /fail on failure), e.g. a healthchecks.io check.
# BACKUP_HEARTBEAT_URL=
